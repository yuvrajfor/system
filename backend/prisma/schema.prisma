generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  SYNDICATE_LEAD
  MEMBER
  GUEST
  CANDIDATE
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  googleId String @unique
  role Role @default(GUEST)
  syndicateId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syndicate Syndicate? @relation(fields: [syndicateId], references: [id], onDelete: SetNull)

  // Interview & Feedback system relations
  createdSlots InterviewSlot[] @relation("AdminCreatedSlots")
  bookings Booking[] @relation("CandidateBookings")
  receivedFeedbacks Feedback[] @relation("CandidateFeedbacks")
  givenFeedbacks Feedback[] @relation("AdminGivenFeedbacks")
  improvementTasks ImprovementTask[] @relation("CandidateTasks")
  assignedTasks ImprovementTask[] @relation("AdminAssignedTasks")

  @@index([syndicateId, role])
}

model Syndicate {
  id String @id @default(uuid())
  name String @unique
  description String
  resourcesAllocated Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members User[]
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

model InterviewSlot {
  id String @id @default(uuid())
  adminId String
  startTime DateTime
  endTime DateTime
  title String @default("Technical Interview")
  status SlotStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User @relation("AdminCreatedSlots", fields: [adminId], references: [id], onDelete: Cascade)
  booking Booking[]
  feedbacks Feedback[]
  tasks ImprovementTask[]

  @@index([adminId, status])
  @@index([startTime])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id String @id @default(uuid())
  slotId String
  candidateId String
  status BookingStatus @default(CONFIRMED)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidateBookings", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
}

model Feedback {
  id String @id @default(uuid())
  candidateId String
  adminId String
  slotId String?
  remarks String
  strengths String
  weaknesses String
  suggestions String
  rating Int @default(5)
  createdAt DateTime @default(now())

  candidate User @relation("CandidateFeedbacks", fields: [candidateId], references: [id], onDelete: Cascade)
  admin User @relation("AdminGivenFeedbacks", fields: [adminId], references: [id], onDelete: Cascade)
  slot InterviewSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ImprovementTask {
  id String @id @default(uuid())
  candidateId String
  adminId String?
  slotId String?
  title String
  description String?
  status TaskStatus @default(PENDING)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate User @relation("CandidateTasks", fields: [candidateId], references: [id], onDelete: Cascade)
  admin User? @relation("AdminAssignedTasks", fields: [adminId], references: [id], onDelete: SetNull)
  slot InterviewSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([candidateId, status])
}
